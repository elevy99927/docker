version: "3"
services: 
  web:
    image: httpd
    deploy: 
      replicas: 3
      resources:
        limits:
          cpus: "0.2"
          memory: '50M'
  lb:
    image: dockercloud/haproxy
    links: 
      - web
    ports:
      - '80:80'
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
